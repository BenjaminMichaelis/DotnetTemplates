<Project Sdk="Aspire.AppHost.Sdk/13.5.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep NuGet-restored orchestration dependencies instead of requiring a CLI bundle. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" />
    <PackageReference Include="Aspire.Hosting.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <!--#if (applicationInsights)-->
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" />
    <!--#endif-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinimalApi.Core\MinimalApi.Core.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\MinimalApi.Data\MinimalApi.Data.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\MinimalApi\MinimalApi.csproj" />
  </ItemGroup>

</Project>
